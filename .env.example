# Supply your own Coinbase Advanced Trade API credentials locally.
# Never commit a populated .env file.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Observe mode does not place orders.
RUN_MODE=observe
LIVE_CONFIRMATION=
CONFIG_PATH=config/strategy.yaml
LOG_LEVEL=INFO

# Optional notifications; disabled by default.
PUSHOVER_ENABLED=false
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
